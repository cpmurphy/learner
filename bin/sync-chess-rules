#!/usr/bin/env bash
# Keeps lib/chess_rules in step with stockfish-pool's StockfishPool::Rules.
# The pool is the source of truth; this pulls from the ref in POOL_REF.
#
#   bin/sync-chess-rules          rewrite lib/chess_rules from the pool
#   bin/sync-chess-rules --check  exit 1 if out of date (for CI)
#
# san.rb is app-only and is never touched. Set POOL_SRC to use a local checkout.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ "$1" != --check ]; }; then
  echo "usage: bin/sync-chess-rules [--check]" >&2
  exit 1
fi

pool=$("$root/bin/pool-checkout")
exec "$pool/bin/export-chess-rules" "$root/lib/chess_rules" "$@"
