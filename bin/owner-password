#!/usr/bin/env ruby
# frozen_string_literal: true

# Prints an OWNER_PASSWORD_HASH value for a password typed at the prompt
# (or read from standard input when it is not a terminal).
#
#   bin/owner-password
#   OWNER_PASSWORD_HASH='scrypt$16384$8$1$...'   # put this in the app's environment

require 'io/console'
require_relative '../lib/owner_password'

def read_password(prompt)
  return $stdin.gets.to_s.chomp unless $stdin.tty?

  $stderr.print prompt
  password = $stdin.noecho(&:gets).to_s.chomp
  $stderr.puts
  password
end

password = read_password('Owner password: ')
abort 'The password must be at least 12 characters.' if password.length < 12
abort 'The passwords do not match.' if $stdin.tty? && read_password('Again: ') != password

puts OwnerPassword.create(password)
