# Copy to ~/.config/chess-learner/chess-learner.env and `chmod 600` it.
# Format (podman --env-file): KEY=value per line. No quotes, no inline
# comments, no $ expansion: everything after = is the value.

# Same value as API_TOKENS in stockfish-pool.env.
ENGINE_TOKEN=

# Owner login. Generate with bin/owner-password and paste the whole line it
# prints, $ signs included. Leave empty to close the library to everyone
# (visitors can still analyze their own games, which are never stored).
OWNER_PASSWORD_HASH=

# Keys that keep engine quotas and session cookies stable across restarts.
# Generate each with: openssl rand -hex 64
ENGINE_SUBJECT_SECRET=
SESSION_SECRET=

# Address(es) the app sees reverse-proxied requests come from. Rootless
# Podman delivers connections to the published port from the container's own
# address on sf-web, which deploy/quadlet pins to 10.89.10.2. If this is wrong,
# the app logs a warning naming the real address.
TRUSTED_PROXIES=10.89.10.2
