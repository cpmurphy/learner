# Copy to ~/.config/chess-learner/stockfish-pool.env and `chmod 600` it.
# Format (podman --env-file): KEY=value per line. No quotes, no inline
# comments, no $ expansion: everything after = is the value.

# Bearer token(s) the app must present. Generate with: openssl rand -hex 32
# It must equal ENGINE_TOKEN in chess-learner.env.
API_TOKENS=

# Optional overrides; the defaults suit a 3 vCPU / 4 GB VPS shared with other
# services (see stockfish-pool/README.md for every setting).
# POOL_SIZE=2
# GLOBAL_ENGINE_SEC_PER_MIN=90
# INTERACTIVE_MAX_DEPTH=18
